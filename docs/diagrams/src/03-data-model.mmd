erDiagram
    TASKS ||--|{ TASK_EVENTS : "history[] (embedded array, not a table)"

    USERS {
        string id PK "u_admin / u_viewer"
        string name "Display name"
        string email UK "Case-insensitive login"
        string passwordHash "scrypt: salt:hash"
        string role "Administrator | Viewer"
    }

    TASKS {
        string id PK "T-001 (maximum number + 1)"
        string title "Action validates at least 4 characters"
        string description "Action validates at least 10 characters"
        string assignee "Free text; defaults to Unassigned"
        string status "Pending | Approve | To Do | Done | Cancelled"
        string createdBy "Name string, not a foreign key"
        string createdAt "ISO 8601"
        string updatedAt "ISO 8601; list sorted descending"
        array history "TaskEvent[]; append on transition"
    }

    TASK_EVENTS {
        string at "ISO timestamp"
        string from "Source status; null on creation"
        string to "Target status"
        string by "Actor name"
        string note "Note (seed values only; empty at runtime)"
    }

