flowchart LR
    subgraph CLIENT["1. Browser"]
        direction TB
        UI1["User interactions<br/>Login / filter / submit forms"]
        UI2["Client components (use client)<br/>LoginForm / NewTaskForm / SubmitButton"]
    end

    subgraph SERVER["2. Next.js Server (single Node process)"]
        direction TB
        subgraph PAGE["RSC pages (App Router)"]
            direction TB
            PG1["/ · /login"]
            PG2["/tasks · /tasks/new"]
            PG3["/tasks/[id] · not-found"]
        end
        subgraph ACTION["Server Actions (lib/actions.ts)"]
            direction TB
            AC1["loginAction<br/>logoutAction"]
            AC2["createTaskAction"]
            AC3["transitionAction<br/>deleteTaskAction"]
        end
        subgraph DOMAIN["Domain modules: lib/"]
            direction TB
            DM1["auth.ts<br/>HMAC session cookie"]
            DM2["password.ts<br/>scrypt hashing / verification"]
            DM3["workflow.ts<br/>TRANSITIONS status table"]
            DM4["format.ts · types.ts"]
        end
        STORE["store.ts<br/>Only data-file access module"]
    end

    subgraph DATA["3. Storage (filesystem)"]
        direction TB
        JSON["data/db.json"]
        U["users[]"]
        T["tasks[]<br/>includes history[]"]
    end

    CROSS["Cross-cutting settings<br/>TypeScript strict · Tailwind CSS 4<br/>SESSION_SECRET · DB_PATH"]

    UI1 --> UI2
    UI2 -->|"Form POST"| ACTION
    UI1 -->|"Navigation / refresh"| PAGE
    PAGE -->|"Session guards: requireSession / requireAdmin"| DM1
    PAGE -->|"Direct RSC reads"| STORE
    ACTION -->|"Authorization / status checks / user lookup"| DOMAIN
    ACTION -->|"Write"| STORE
    STORE -->|"Read: JSON.parse<br/>Write: temp file + rename"| JSON
    JSON --- U
    JSON --- T
    CROSS -.-> SERVER
