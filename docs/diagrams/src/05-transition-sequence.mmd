sequenceDiagram
    autonumber
    actor U as Administrator
    participant PG as /tasks/[id] page (RSC)
    participant AC as transitionAction (server)
    participant WF as workflow.ts
    participant ST as store.ts
    participant CO as Session cookie

    PG->>WF: nextStatuses(task.status)
    WF-->>PG: Allowed targets (buttons and forms)
    U->>AC: Submit form (hidden id and to)
    AC->>CO: getSession()
    alt No session
        AC->>PG: redirect("/login")
    else Authenticated
        AC->>AC: role !== Administrator ?
        alt Not an administrator
            AC->>PG: redirect("/tasks/[id]?error=forbidden")
        else Administrator
            AC->>WF: isTaskStatus(to)
            alt Unknown status
                AC->>PG: redirect("?error=unknown-status")
            else Valid status value
                AC->>ST: getTask(id)
                ST-->>AC: Task / null
                alt Task not found
                    AC->>PG: redirect("/tasks?error=not-found")
                else Task found
                    AC->>WF: canTransition(task.status, to)
                    alt Illegal transition from stored status
                        AC->>PG: redirect("?error=illegal-transition")
                    else Valid transition
                        AC->>ST: transitionTask(id, to, by)
                        ST->>ST: Append history and update status/updatedAt
                        ST->>ST: writeDb() (temp file + rename)
                        AC->>AC: revalidatePath for list and detail
                        AC->>PG: redirect("?ok=1")
                        PG-->>U: Render updated page and allowed actions
                    end
                end
            end
        end
    end
