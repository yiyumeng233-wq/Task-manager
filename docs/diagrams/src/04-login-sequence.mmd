sequenceDiagram
    autonumber
    actor U as User
    participant LF as LoginForm (client)
    participant AC as loginAction (server)
    participant ST as store.ts
    participant PW as password.ts
    participant AU as auth.ts
    participant PG as /tasks page (RSC)

    U->>LF: Enter email and password (demo autofill available)
    LF->>AC: Submit form (useActionState)
    AC->>AC: Validate required fields
    alt Missing fields
        AC-->>LF: return { error: "Email and password are required." }
        LF-->>U: Show inline form error
    else All fields present
        AC->>ST: findUserByEmail(email.trim().toLowerCase())
        ST-->>AC: User | null
        alt User not found
            AC-->>LF: return { error: "Invalid email or password." }
        else User found
            AC->>PW: verifyPassword(password, passwordHash)
            PW-->>AC: true / false
            alt Wrong password
                AC-->>LF: return { error: "Invalid email or password." }
            else Password verified
                AC->>AU: startSession({ uid, name, role })
                AU-->>AC: Set httpOnly cookie (HMAC-signed, 8h)
                AC->>PG: redirect("/tasks")
            end
        end
    end
    PG->>AU: requireSession() → verifyToken(cookie)
    AU-->>PG: Session
    PG->>ST: listTasks()
    ST-->>PG: Task[] (updatedAt descending)
    PG-->>U: Render tasks and role-based actions

